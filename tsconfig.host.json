{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "lib",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/host/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "lib", "tests", "scripts", "src/client"]
}
